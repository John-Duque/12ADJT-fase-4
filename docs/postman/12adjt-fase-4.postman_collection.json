    {
      "name": "weekly-report",
      "item": [
        {
          "name": "Gerar relatório",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status 200', () => pm.response.to.have.status(200));",
                  "const body = pm.response.json();",
                  "pm.test('Período presente', () => {",
                  "    pm.expect(body.startDate).to.match(/^\\d{4}-\\d{2}-\\d{2}$/);",
                  "    pm.expect(body.endDate).to.match(/^\\d{4}-\\d{2}-\\d{2}$/);",
                  "});",
                  "pm.test('Sem avaliações enquanto não há banco', () => pm.expect(body.totalFeedbacks).to.eql(0));",
                  "pm.test('7 dias em countByDay', () => pm.expect(Object.keys(body.countByDay)).to.have.lengthOf(7));",
                  "pm.test('Todas as urgências em countByUrgency', () => pm.expect(body.countByUrgency).to.have.all.keys('HIGH', 'MEDIUM', 'LOW'));"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [],
            "url": {
              "raw": "{{reportUrl}}/generate-weekly-report",
              "host": [
                "{{reportUrl}}"
              ],
              "path": [
                "generate-weekly-report"
              ]
            },
            "description": "Relatório dos 7 dias anteriores. Sai zerado enquanto não houver banco."
          }
        }
      ]
    },
