        {
          "name": "Nota alta → LOW",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status 201', () => pm.response.to.have.status(201));",
                  "const body = pm.response.json();",
                  "pm.test('Urgência LOW', () => pm.expect(body.urgencia).to.eql('LOW'));",
                  "pm.test('id e dataEnvio presentes', () => {",
                  "    pm.expect(body.id).to.be.a('string').and.not.empty;",
                  "    pm.expect(body.dataEnvio).to.be.a('string').and.not.empty;",
                  "});"
                ]
              }
